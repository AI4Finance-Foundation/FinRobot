# FinAgent Configuration
# Copy to .env and fill in your keys:  cp .env.example .env

# LLM Provider (required -- choose one)
# Format: provider:model_id
FINAGENT_MODEL_NAME=deepseek:deepseek-chat

# API Keys -- only fill the one matching your model
FINAGENT_ANTHROPIC_API_KEY=
FINAGENT_DEEPSEEK_API_KEY=
FINAGENT_OPENAI_API_KEY=

# Data Sources (optional -- enhances data quality)
# FINAGENT_FMP_API_KEY=           # Financial Modeling Prep -- provides D&A for standard DCF formula
# FINAGENT_FINNHUB_API_KEY=       # Finnhub -- alternative financial data
# FINAGENT_SEC_USER_AGENT=YourCompany you@email.com  # SEC EDGAR requires User-Agent

# Infrastructure (optional)
# FINAGENT_CACHE_DB_PATH=         # Default: ~/.cache/finagent/cache.db
# FINAGENT_LOG_LEVEL=INFO
# FINAGENT_HOST=127.0.0.1
# FINAGENT_PORT=8321
