# Local data (root-only — must not shadow finrobot/engine/data/)
/data/
# "materials" — local reference files
资料/

# Environment
.env
.env.local
.env.development
.env.production

# Desktop / Electron
node_modules/
desktop/dist/
desktop/out/
desktop/.vite/
# Internal docs — local only, not published. Kept for Claude / Codex to read
# across sessions; not committed. Only README.md and the runtime assets
# (finrobot/engine/**/instructions, skills/) go into git.
ARCHITECTURE.md
CODE_OF_CONDUCT.md
CONTRIBUTING.md
REVIEW_FINDINGS.md
specs/
docs/
AGENTS.md
CLAUDE.md

# Claude Code config (local, not version-controlled)
.claude/

# npx skills lock file. The skills themselves live in .claude/skills/, already
# ignored along with .claude/; the lock file stays out of the repo too.
skills-lock.json

# Codex CLI config (local, not version-controlled)
.codex/

# AI development memory (local, not version-controlled)
project-memory/

# Research (unconfirmed directions, not open-sourced)
# "research" — local scratch directory
调研/

# evolve.sh — private module-level autopilot (script + runtime artifacts)
scripts/evolve.sh
scripts/evolve_progress.py
scripts/.evolve_state.json
scripts/evolve_raw.jsonl
scripts/evolve.log

# Desktop sidecar binaries — multi-hundred-MB PyInstaller onedir output, frozen
# locally / in CI by desktop/src-tauri/sidecar/build.sh into sidecar/dist/. The
# source (spec + entry + build script under desktop/src-tauri/sidecar/) is
# tracked; the frozen output is not. desktop/.gitignore's generic `dist/` already
# catches this, but this explicit root rule is the backstop so the bundle can
# never leak into git if that generic rule is ever narrowed.
desktop/src-tauri/sidecar/dist/

# understand-anything — local codebase-analysis tool cache (graph/batches/tmp).
# Regenerated on demand; never part of the project source.
.understand-anything/

# design-demos — throwaway output from UI redesign exploration (HTML mockups +
# screenshots). Local reference only, not committed.
design-demos/

# rope's local cache, created by scripts/find_refs.py on each run; never source.
.ropeproject/

# Release runbook — a private local note (release steps and account details),
# kept out of version control.
/发布须知.md

# App icon master — the 1024² RGBA squircle source (a tile cropped from the
# design original, with a rounded-corner transparent mask).
# Regenerate with: cd desktop && npm run tauri icon -- src-tauri/icon-source.png
# At 1.1MB it exceeds pre-commit's 500KB limit. The generated icon set (icns /
# ico / PNG / Windows tiles under icons/) is committed; this master stays local
# as the regeneration source and is not version-controlled.
desktop/src-tauri/icon-source.png

# coverage measurement artifacts (pytest --cov, explicit runs only)
.coverage
.coverage.*
htmlcov/

# Playwright output — .last-run.json marker + traces/screenshots/report, regenerated each run.
test-results/
playwright-report/
