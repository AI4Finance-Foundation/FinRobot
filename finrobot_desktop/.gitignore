# Desktop sidecar binaries — multi-hundred-MB PyInstaller output, regenerated
# locally / in CI by src-tauri/sidecar/build.sh. The source (spec + entry +
# build script under src-tauri/sidecar/) is tracked; the frozen output is not.
src-tauri/binaries/finrobot-server-*

# understand-anything — local codebase-analysis tool cache (graph/batches/tmp).
# Regenerated on demand; never part of the project source.
.understand-anything/

# design-demos — UI 重设计探索的临时产物（HTML mockup + 截图），本地参考用，不进仓库
design-demos/
