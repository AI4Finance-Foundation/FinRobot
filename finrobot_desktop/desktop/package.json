{
  "name": "finrobot-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "dev": "npm run lingui:compile && npm run build:viewer && vite",
    "build": "npm run lingui:compile && npm run build:viewer && tsc -b && vite build",
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "lingui:compile": "lingui compile",
    "lingui:extract": "lingui extract",
    "i18n:check": "node scripts/check-lingui-catalogs.mjs && node scripts/check-i18n-orphans.mjs",
    "preview": "vite preview",
    "lint": "eslint src/ --ext .ts,.tsx",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' && npm run i18n:check",
    "generate:api": "npx openapi-typescript http://127.0.0.1:8321/openapi.json -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "test": "npm run lingui:compile && vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=chromium",
    "tauri": "tauri"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.182",
    "@ai-sdk/ui-utils": "^1.2.11",
    "@fontsource/audiowide": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@lingui/core": "^6.1.0",
    "@lingui/react": "^6.1.0",
    "@splinetool/viewer": "^1.9.54",
    "@tanstack/react-query": "^5.100.9",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "use-debounce": "^10.1.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@lingui/cli": "^6.1.0",
    "@lingui/format-po": "^6.1.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0",
    "@typescript-eslint/parser": "^8.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0",
    "eslint-plugin-react": "^7.37",
    "eslint-plugin-react-hooks": "^5.0",
    "globals": "^17.6.0",
    "jsdom": "^29.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.2"
  }
}
