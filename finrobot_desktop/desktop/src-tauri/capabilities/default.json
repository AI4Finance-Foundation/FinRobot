{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions for FinRobot Desktop",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/finrobot-server",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "shell:allow-open",
    "dialog:default",
    "dialog:allow-save",
    "fs:default",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$HOME/**" }]
    },
    "global-shortcut:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "os:default",
    "os:allow-locale"
  ]
}
