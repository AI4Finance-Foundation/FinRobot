{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FinRobot",
  "version": "0.1.0",
  "identifier": "com.finrobot.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FinRobot",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 13 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/finrobot-server"]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/__GH_OWNER__/finrobot-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEMzgwMkQxNkZGQUNFMjQKUldRa3p2cHYwUUk0L1VKRjVqQWx3cVRkZU9YclBOQjNIcVNoRlVRYWE2dlJYQTRVQzF0dWw5ajAK"
    }
  }
}
