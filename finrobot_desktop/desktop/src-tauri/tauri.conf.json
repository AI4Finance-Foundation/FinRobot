{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FinRobot",
  "mainBinaryName": "FinRobot",
  "version": "0.1.0",
  "identifier": "com.finrobot.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FinRobot",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 16 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.spline.design; font-src 'self' data:; media-src 'self' data: blob: https://*.spline.design; connect-src 'self' http://127.0.0.1:8321 https://github.com https://*.githubusercontent.com https://*.spline.design https://unpkg.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": { "sidecar/dist/finrobot-server": "sidecar" }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/AI4Finance-Foundation/FinRobot/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEMzgwMkQxNkZGQUNFMjQKUldRa3p2cHYwUUk0L1VKRjVqQWx3cVRkZU9YclBOQjNIcVNoRlVRYWE2dlJYQTRVQzF0dWw5ajAK"
    }
  }
}
