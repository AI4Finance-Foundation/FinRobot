{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions for FinAgent Desktop",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/finagent-server",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "shell:allow-open",
    "dialog:default",
    "fs:default",
    "global-shortcut:default"
  ]
}
